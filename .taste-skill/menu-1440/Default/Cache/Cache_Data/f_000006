:root {
  --p-bg:#ffffff; --p-surface:#f0f6fc; --p-ink:#182b45; --p-muted:#56677d;
  --p-accent:#006edb; --p-accent-ink:#ffffff; --p-action:#006edb; --p-action-ink:#ffffff;
  --p-inv-bg:#0751c4; --p-inv-ink:#ffffff; --p-inv-muted:#dcecff;
  --font-display:'Urbanist',system-ui,sans-serif; --font-text:'Urbanist',system-ui,sans-serif;
  --font-mono:'DM Mono',ui-monospace,monospace; --display-weight:600;
  --display-tracking:-.03em; --display-tracking-xl:-.04em;
}
body { background:#fff; color:#182b45; }
.brand { font-size:28px; font-weight:700; letter-spacing:-.05em; text-decoration:none; }
.brand-dot { color:#ffd775; }
header.nav { background:#006edb; color:white; border:0; box-shadow:none; }
.nav .nav__bar { min-height:76px; }
.nav .nav__logo,.nav .nav__link { color:#fff; }
.nav .nav__links { position:static; transform:none; margin-left:auto; margin-right:32px; display:flex; align-items:center; height:100%; }
.nav .nav-start { background:#fff; color:#0064c7; min-height:44px; border-color:#fff; font-weight:600; white-space:nowrap; }
.hero--robokan { position:relative; min-height:900px; min-height:100svh; height:auto!important; padding:114px 0 40px; overflow:hidden; color:white; background-color:#0751c4; background-image:linear-gradient(#ffffff09 1px,transparent 1px),linear-gradient(90deg,#ffffff09 1px,transparent 1px); background-size:88px 88px; }
.home-layout { display:flex; flex-direction:column; align-items:center; gap:28px; }
.hero--robokan .hero__text { text-align:center; max-width:820px; }
.hero--robokan .hero__kicker { color:#d4e8ff; font:500 12px var(--font-mono); letter-spacing:.12em; margin:0 0 14px; }
.hero--robokan h1 { color:#fff; font-size:clamp(44px,4.9vw,68px); line-height:1.03; letter-spacing:-.04em; margin:0; font-weight:600; }
.hero--robokan .hero__lead { color:#e4efff; font-size:19px; line-height:1.5; max-width:660px; margin:18px auto 22px; }
.hero--robokan .btn-row { justify-content:center; }
.hero--robokan .btn--primary { background:#fff; color:#0064c7; border-color:#fff; padding-inline:28px; min-height:50px; font-weight:600; }
.hero--robokan .hero__proof { color:#cee4ff; font-size:14px; margin:14px 0 0; }
.hero--robokan .hero__art { width:min(850px,100%); height:auto; background:transparent; border:0; overflow:visible; border-radius:12px; }
.app-frame { background:#fff; border:1px solid #c6d2c8; border-radius:12px; box-shadow:0 22px 48px #1736251a; color:#263833; overflow:hidden; }
.app-bar,.app-steps,.app-bottom { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.app-bar { height:50px; padding:0 18px; background:#203c35; color:white; font-size:14px; }
.window-dots { color:#acc7b9; font-size:10px; letter-spacing:3px; }
.preview-label { font-size:12px; color:#c9dcd0; }
.app-steps { justify-content:flex-start; padding:17px 20px; border-bottom:1px solid #e4e9e5; font-size:13px; gap:22px; }
.app-steps strong { color:#a40a55; font-weight:600; }
.workbench { display:grid; grid-template-columns:42% 58%; height:330px; }
.program-pane { position:relative; border-right:1px solid #e0e7e2; background:#fcfcfa; min-width:0; }
.pane-heading { padding:18px 16px 14px; font-size:14px; font-weight:600; display:flex; justify-content:space-between; gap:10px; }
.code-mark { color:#738079; }
.language-tabs { display:flex; gap:4px; margin:0 14px 22px; background:#ecf0ec; padding:4px; border-radius:7px; }
.language-tabs button { flex:1; min-height:44px; border:0; background:transparent; border-radius:5px; font:500 13px var(--font-text); color:#4c5a53; cursor:pointer; }
.language-tabs [aria-selected="true"] { background:white; color:#203c35; box-shadow:0 1px 4px #203c3515; }
.block-workspace { padding:0 14px; }
.code-block { border-radius:5px; padding:12px 10px; font-size:13px; font-weight:600; line-height:1.35; }
.event-block { background:#f5cf71; color:#59400c; width:80%; margin-bottom:3px; border-bottom:3px solid #c89d39; }
.control-block { background:#f6ddb0; color:#674a23; }
.block-inner { padding-left:10px; margin-top:12px; border-left:3px solid #bc8734; }
.sensor-block { background:#bce0cb; color:#234f3a; }
.sensor-block span { padding:1px 4px; background:white; border-radius:3px; }
.move-block { background:#c3e0ec; color:#23495c; margin-top:5px; }
.pane-foot { position:absolute; bottom:18px; left:16px; color:#65766d; font-size:12px; }
.python-view { padding:0 14px; }
.python-view pre { white-space:pre-wrap; font:11px/1.9 var(--font-mono); color:#254d3b; }
.arena-pane { display:flex; flex-direction:column; min-width:0; }
.arena-view { font:9px var(--font-mono); color:#68766f; margin-top:3px; }
.arena { position:relative; flex:1; margin:4px 14px 14px; min-height:180px; border:1px solid #d8e1d7; border-radius:5px; overflow:hidden; background-color:#edf2e8; background-image:linear-gradient(#dce4d980 1px,transparent 1px),linear-gradient(90deg,#dce4d980 1px,transparent 1px); background-size:24px 24px; }
.robot { position:absolute; width:85px; height:100px; left:calc(50% - 42px); top:50%; background:#e5b95f; border-radius:14px 14px 10px 10px; box-shadow:0 8px 0 #b48f46,0 15px 18px #233c352b; }
.wheel { position:absolute; width:16px; height:55px; top:30px; border-radius:5px; background:repeating-linear-gradient(#253a33 0 4px,#3e5148 4px 7px); }
.wheel-left { left:-10px; }.wheel-right { right:-10px; }
.sensor { display:flex; justify-content:space-around; position:absolute; top:-9px; left:13px; width:60px; height:23px; padding:3px; background:#4d8d87; border-radius:4px; }
.sensor i { width:17px; height:17px; border:4px solid #cdd4d2; background:#304942; border-radius:50%; }
.board { position:absolute; top:30px; left:20px; width:45px; height:46px; background:#43795f; border:4px dotted #aac4a8; border-radius:3px; text-align:center; color:#dcebdc; font:16px/36px var(--font-mono); }
.sensor-rays { position:absolute; top:20%; left:calc(50% - 66px); width:132px; height:46%; background:#c0d7a6a0; clip-path:polygon(0 0,100% 0,50% 100%); }
.obstacle { position:absolute; background:#c7b6a1; border-radius:4px; box-shadow:3px 5px 0 #ab9a86; }
.obstacle-a { top:13%; left:25%; width:46px; height:45px; }.obstacle-b { top:38%; right:8%; width:34px; height:74px; }.obstacle-c { bottom:10%; left:9%; width:36px; height:32px; }
.arena-origin { position:absolute; left:10px; bottom:8px; font:10px var(--font-mono); color:#536c5a; }
.arena-foot { display:flex; flex-wrap:wrap; gap:7px; padding:0 14px 17px; }
.arena-foot span { font-size:11px; border:1px solid #dbe5dc; border-radius:4px; padding:4px 6px; }
.app-bottom { padding:14px 16px; background:#f3f6f1; border-top:1px solid #dde5de; font-size:11px; }

.app-frame { box-shadow:0 18px 42px #00226038; }
.app-bar { background:#f7faff; color:#293c55; height:40px; border-bottom:1px solid #dfE8f2; }
.window-dots { color:#a6b7cb; }.preview-label { color:#506783; }
.app-steps { padding:12px 20px; }.app-steps strong { color:#006edb; }
.program-pane { background:#fcfdff; }.language-tabs { background:#eaf1f9; margin-bottom:14px; }
.arena { background-color:#eaf4ff; background-image:linear-gradient(#bcd4ef70 1px,transparent 1px),linear-gradient(90deg,#bcd4ef70 1px,transparent 1px); }
.app-bottom { padding:10px 16px; background:#f4f8fd; border-color:#dfe8f2; }
.arena-foot { padding-bottom:12px; }.robot { top:46%; }
.pane-foot { display:none; }.code-block { padding:9px 10px; }
.learning-section { background:#fff; padding:84px 0 32px; min-height:calc(100svh - 76px); height:auto; }
.lab-content { text-align:center; }
.lab-content .t-label { color:#006edb; font-size:12px; letter-spacing:.08em; }
#laboratorio h2 { font-size:clamp(32px,3.6vw,48px); line-height:1.1; font-weight:600; margin:20px 0; }
.lab-lead { max-width:720px; color:#56677d; font-size:20px; line-height:1.6; margin:0 auto; }
.learning-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:64px; margin:62px 0 72px; }
.learning-item { text-align:center; }.learning-icon { width:96px; height:96px; margin:0 auto 24px; }.learning-icon svg { width:100%; height:100%; }
.icon-blue { color:#0075db; }.icon-orange { color:#c96a0c; }.icon-green { color:#168245; }
.learning-item h3 { font-weight:600; font-size:23px; line-height:1.25; margin:0 0 16px; }
.learning-item p { color:#56677d; font-size:18px; line-height:1.65; max-width:290px; margin:0 auto; }
.lab-bottom { display:flex; align-items:center; justify-content:space-between; gap:20px; text-align:left; padding-top:28px; border-top:1px solid #dfe8f2; color:#56677d; font-size:14px; }
.lab-bottom .brand { color:#006edb; font-size:24px; }.lab-bottom .brand-dot { color:#006edb; }
dialog::backdrop { background:#092a6099; backdrop-filter:blur(5px); }
.close-dialog { cursor:pointer; }
@media(min-width:1600px) { .hero--robokan { display:flex; align-items:center; } }
@media(max-width:1023px) { .hero--robokan { min-height:100svh; padding-top:110px; }.learning-grid { gap:28px; }.learning-item h3 { font-size:21px; }.app-frame { width:100%; }.nav .nav__links { margin-right:20px; } }
@media(max-width:639px) {
  .nav .nav__bar { min-height:68px; }.nav .brand { font-size:23px; }.nav__links { display:none!important; }.nav .nav-start { font-size:13px; padding:10px 15px; margin-left:auto; }
  .hero--robokan { padding:102px 0 32px; }.home-layout { gap:24px; }.hero--robokan .hero__kicker { font-size:10px; letter-spacing:.07em; }.hero--robokan h1 { font-size:42px; }.hero--robokan .hero__lead { font-size:17px; margin:18px auto 22px; }.hero--robokan .hero__proof { font-size:13px; }.hero--robokan .btn-row .btn { width:100%; }.hero--robokan .hero__art { width:100%; }
  .workbench { height:280px; grid-template-columns:47% 53%; }.app-bar { padding:0 10px; font-size:11px; }.preview-label { font-size:10px; }.window-dots { font-size:8px; letter-spacing:1px; }.app-steps { font-size:11px; gap:14px; padding:10px 12px; }.pane-heading { padding:12px 9px; font-size:12px; }.arena-view,.arena-foot,.pane-foot { display:none; }.language-tabs { margin:0 8px 14px; }.language-tabs button { font-size:12px; }.block-workspace { padding:0 8px; }.code-block { font-size:10px; padding:8px 6px; }.block-inner { padding-left:4px; margin-top:8px; }.arena { margin:0 8px 12px; min-height:120px; }.robot { transform:scale(.65); transform-origin:center top; top:48%; }.obstacle-a { width:28px; height:28px; }.obstacle-b { width:20px; height:42px; }.obstacle-c { width:24px; height:24px; }.app-bottom { font-size:9px; padding:10px; }.app-bottom span:last-child { display:none; }.python-view { padding:0 9px; }.python-view pre { font-size:9px; }
  .learning-section { padding:60px 0 28px; }.lab-lead { font-size:18px; }.learning-grid { grid-template-columns:1fr; gap:42px; margin:42px 0; }.learning-icon { margin-bottom:16px; width:84px; height:84px; }.learning-item h3 { font-size:23px; }.learning-item p { max-width:330px; font-size:17px; }.lab-bottom { flex-direction:column; align-items:flex-start; gap:12px; }dialog { padding:24px; }
}

/* Let the reference-led stacked hero grow instead of clipping the editor. */
main > section.hero--robokan { height:auto!important; min-height:100svh; overflow:visible; }
main > section.hero--robokan > .wrap { height:auto!important; display:block; }
main > section.hero--robokan > .wrap > .home-layout { height:auto; flex:none; }
.hero--robokan .hero__kicker { justify-content:center; }
header.nav .nav__links { align-self:center; height:auto; }main > section.hero--robokan { display:block!important; }
main > section.hero--robokan .home-layout { display:grid; grid-template-columns:minmax(0,1fr); grid-template-rows:auto auto; justify-items:center; }
.hero--robokan .hero__art { min-height:450px; }
@media(max-width:639px) { .hero--robokan .hero__art { min-height:390px; } }
/* Reference-led robot selection dashboard; no account or backend controls. */
html:has(.project-menu[open]) { overflow:hidden; }
#start-dialog.project-menu { width:min(1280px,calc(100vw - 48px)); max-width:none; height:min(780px,calc(100dvh - 48px)); max-height:none; padding:0; border:0; border-radius:14px; overflow:hidden; background:#f3f5f8; box-shadow:0 24px 100px #00234855; }
.project-menu-header { display:flex; align-items:center; gap:28px; height:76px; padding:0 28px; background:#006edb; color:white; }
.menu-header-label { font:12px var(--font-mono); letter-spacing:.1em; color:#deeeff; }
.project-menu-header .menu-close { margin-left:auto; color:white; border:1px solid #ffffff66; border-radius:50%; font-size:28px; line-height:1; width:44px; height:44px; background:transparent; }
.project-menu-layout { display:grid; grid-template-columns:210px minmax(0,1fr); height:calc(100% - 76px); }
.project-sidebar { display:flex; flex-direction:column; align-items:center; background:white; border-right:1px solid #dde4ee; padding:32px 16px 24px; text-align:center; }
.workspace-avatar { display:grid; place-items:center; width:76px; height:76px; border-radius:50%; background:#e6f1ff; color:#006edb; font-size:36px; font-weight:600; margin-bottom:18px; }
.project-sidebar strong { font-size:17px; font-weight:600; }.project-sidebar p { font-size:14px; color:#68788e; line-height:1.5; margin:10px 0 24px; }
.sidebar-current { display:flex; align-items:center; gap:10px; width:100%; padding:12px; border:1px solid #b5d6fa; border-radius:24px; background:#f0f7ff; color:#0065ca; font-size:15px; font-weight:600; }.sidebar-current svg { width:22px; height:22px; }
.sidebar-note { margin-top:auto; align-self:flex-start; text-align:left; color:#9aadc4; font-size:27px; font-weight:500; line-height:1.4; padding:24px 10px 0; }
.project-menu-content { overflow:auto; padding:28px; overscroll-behavior:contain; }
.project-welcome { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:30px; background:#e4f0ff; border:1px solid #cfE1f8; border-radius:12px; }
.menu-eyebrow { font:11px var(--font-mono); letter-spacing:.08em; color:#0864bd; margin:0 0 12px; }
.project-menu h2 { font-size:34px; font-weight:600; line-height:1.12; margin:0 0 12px; color:#163a62; }.project-welcome #start-description { font-size:17px; line-height:1.5; color:#49647f; margin:0; max-width:500px; }
.welcome-symbol { display:grid; place-items:center; flex:none; width:84px; height:84px; border-radius:20px; background:#fff9; color:#006edb; font-size:64px; font-weight:400; }
.project-section-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin:30px 0 18px; }.project-section-heading h3 { margin:0; font-size:23px; font-weight:600; }.project-section-heading>span { font-size:13px; color:#60748d; }
.project-options { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
.project-option { display:flex; flex-direction:column; padding:0; min-width:0; overflow:hidden; text-align:left; border:1px solid #d5dfe9; border-radius:10px; background:white; font-family:var(--font-text); color:#182b45; cursor:pointer; }
.project-option[aria-pressed='true'] { border-color:#006edb; box-shadow:0 0 0 2px #006edb; }
.project-option:focus-visible { outline:3px solid #006edb; outline-offset:4px; }
.project-art { display:block; position:relative; height:180px; width:100%; overflow:hidden; background-size:22px 22px; background-image:linear-gradient(#ffffff70 1px,transparent 1px),linear-gradient(90deg,#ffffff70 1px,transparent 1px); }
.art-avoider { background-color:#d9edf3; }.art-line { background-color:#e4eee0; }.art-blank { background-color:#f0f4fa; display:grid; place-items:center; }
.project-art .robot { top:58px; left:calc(50% - 42px); transform:scale(.72); transform-origin:center center; }
.art-line .robot { background:#86b8e5; box-shadow:0 8px 0 #5183b0,0 15px 18px #233c352b; transform:scale(.72) rotate(90deg); top:69px; left:28px; }
.tile-obstacle { position:absolute; top:26px; right:30px; width:45px; height:38px; border-radius:5px; background:#e7b26d; box-shadow:0 5px 0 #bc8648; }.tile-obstacle-small { left:26px; right:auto; top:112px; width:32px; height:28px; }
.tile-sensor-rays { position:absolute; width:88px; height:66px; top:18px; left:calc(50% - 44px); background:#8fcfc280; clip-path:polygon(0 0,100% 0,50% 100%); }.line-route { position:absolute; inset:0; width:100%; height:100%; }
.blank-plus { display:grid; place-items:center; width:80px; height:80px; border:2px dashed #9ebde0; color:#006edb; border-radius:16px; font-size:56px; line-height:1; }
.project-option-body { display:flex; flex:1; flex-direction:column; gap:12px; padding:20px; width:100%; }.project-kind { font:10px var(--font-mono); letter-spacing:.05em; color:#667c95; }.project-option-body>strong { font-size:22px; font-weight:600; line-height:1.15; }.project-description { font-size:15px; line-height:1.6; color:#5a6d84; }.project-choose { display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:6px; font-size:15px; color:#0065ca; font-weight:600; }.selection-check { visibility:hidden; }.project-option[aria-pressed='true'] .selection-check { visibility:visible; }
.selection-status { margin:20px 0 0; font-size:16px; color:#0065ca; font-weight:600; min-height:24px; }.menu-prototype-notice { margin:12px 0 0; font-size:13px; line-height:1.5; color:#68788e; }
@media(max-width:1000px) { .project-menu-layout { grid-template-columns:170px minmax(0,1fr); }.project-menu-content { padding:22px; }.project-options { grid-template-columns:1fr; }.project-option { flex-direction:row; }.project-art { flex:none; width:190px; height:auto; min-height:200px; }.project-option-body>strong { font-size:23px; }.project-welcome { padding:24px; }.welcome-symbol { display:none; }.project-menu h2 { font-size:30px; } }
