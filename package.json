{
  "name": "robokan",
  "version": "0.1.0",
  "private": true,
  "description": "Educational robotics simulator with an isolated circuit rule test harness",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/home-menu.test.cjs && vitest run --exclude '**/*.cjs'",
    "test:circuit": "vitest run tests/circuit-",
    "typecheck:circuit": "tsc --project tsconfig.circuit.json --noEmit",
    "format:check": "prettier --check \"src/core/**/*.ts\" \"src/modules/circuit/*.{ts,tsx,css}\" \"src/dev/circuit-*.ts\" \"src/dev/dev-circuit.tsx\" \"tests/circuit-*.test.ts\""
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1",
    "@babylonjs/loaders": "^9.37.1",
    "blockly": "^12.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
